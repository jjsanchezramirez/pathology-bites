# ==============================================================================
# PATHOLOGY BITES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# ==============================================================================
# APPLICATION
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Enable maintenance mode (redirects all pages to /maintenance)
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Enable the public knowledge pages (/e, /m, /g). Only the literal value "1"
# enables them in production (any other value = off). Read at request time in
# server components (src/features/public/knowledge/lib/enabled.ts) — set it and
# restart; no rebuild. Dev/preview always on. Does NOT gate the homepage hero
# knowledge-graph cloud.
NEXT_PUBLIC_KNOWLEDGE_PAGES=false

# ==============================================================================
# QUIZ LIMITS (src/shared/config/quiz-limits.ts)
# ==============================================================================
# All optional; the values below are the built-in defaults applied when unset.
NEXT_PUBLIC_MIN_QUESTIONS_PER_QUIZ=5
NEXT_PUBLIC_MAX_QUESTIONS_PER_QUIZ=50
NEXT_PUBLIC_MAX_QUIZZES_PER_DAY=50
NEXT_PUBLIC_MAX_QUESTIONS_PER_DAY=100
NEXT_PUBLIC_SECONDS_PER_QUESTION=60

# ==============================================================================
# TEXT ZOOM (src/shared/utils/ui/text-zoom.ts)
# ==============================================================================
# Accessibility zoom bounds, as a multiplier of the 16px base font. Optional.
NEXT_PUBLIC_MIN_TEXT_ZOOM_SIZE=0.75
NEXT_PUBLIC_MAX_TEXT_ZOOM_SIZE=1.25
NEXT_PUBLIC_DEFAULT_TEXT_ZOOM_SIZE=1.0
NEXT_PUBLIC_TEXT_ZOOM_STEP=0.05

# ==============================================================================
# DATABASE (Supabase)
# ==============================================================================
# Get from: https://app.supabase.com/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# STORAGE (Cloudflare R2)
# ==============================================================================
# Required for image uploads and assets
# Get from: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# Server-side only: public base URL of the R2 bucket serving generated data
# artifacts (IHC matrices, cell-quiz / virtual-slide image indexes). Read by
# src/app/api/public/tools/* routes.
CLOUDFLARE_R2_DATA_PUBLIC_URL=https://pub-yyyyy.r2.dev

# ==============================================================================
# SECURITY (Cloudflare Turnstile)
# ==============================================================================
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# Test key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITEKEY=your_turnstile_sitekey

# ==============================================================================
# EMAIL SERVICE (Resend)
# ==============================================================================
# Required for contact form
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# ==============================================================================
# SEO & ANALYTICS
# ==============================================================================
# Optional - improves SEO and provides usage analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# ==============================================================================
# EXTERNAL APIs
# ==============================================================================
# Semantic Scholar - Academic paper search and citations
# Get from: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key

# OncoKB - Somatic variant oncogenicity annotation
# Get from: https://www.oncokb.org/account/settings
ONCOKB_API_KEY=your_oncokb_key

# ==============================================================================
# AI SERVICES (for question generation)
# ==============================================================================
# These keys stay server-side: the only reader is `server-only`-guarded
# ai-keys.ts. Do NOT reference them from client components.

# Get API keys from:
# - Groq: https://console.groq.com/keys
# - Cerebras: https://cloud.cerebras.ai/
# - Gemini: https://aistudio.google.com/app/apikey
# - Claude: https://console.anthropic.com/
# - Mistral: https://console.mistral.ai/
# - Cloudflare Workers AI: dash -> Account API tokens -> Create -> Custom
#   (needs BOTH values below — the API endpoint is scoped to an account. The
#   token needs BOTH "Workers AI Read" AND "Workers AI Edit"; read alone 403s on
#   a custom token. The account id is in any dashboard URL.)

# NOTE: despite the NEXT_PUBLIC_ prefix these are read ONLY in
# src/shared/config/ai-keys.ts, which is `server-only` — they are never inlined
# into the client bundle. The prefix matches what is configured in Vercel today;
# the un-prefixed GROQ_API_KEY / CEREBRAS_API_KEY are optional server-side
# fallbacks, not alternatives you must set.
NEXT_PUBLIC_GROQ_API_KEY=your_groq_key
NEXT_PUBLIC_CEREBRAS_API_KEY=your_cerebras_key
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_key
NEXT_PUBLIC_CLAUDE_API_KEY=your_claude_key
NEXT_PUBLIC_MISTRAL_API_KEY=your_mistral_key
NEXT_PUBLIC_GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key

# Cloudflare Workers AI — the chain's cheap backstop. Deliberately NOT
# NEXT_PUBLIC_: that prefix inlines a value into the browser bundle wherever it
# is referenced. The keys above are safe only because ai-keys.ts is
# `server-only`; this one is safe by name too. Pairs with CLOUDFLARE_ACCOUNT_ID
# (storage section) — the inference endpoint is account-scoped.
CLOUDFLARE_AI_API_TOKEN=your_cloudflare_workers_ai_token

# ==============================================================================
# QUICK START
# ==============================================================================
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Required for basic functionality:
#    - Supabase credentials (all 3 variables)
#    - Cloudflare R2 credentials (for images)
#
# 3. Optional for full functionality:
#    - Turnstile keys (for CAPTCHA)
#    - Resend API key (for contact form)
#    - Analytics IDs (for tracking)
#    - AI API keys (for question generation)
#
# 4. Start development:
#    npm run dev

# ==============================================================================
# SECURITY NOTES
# ==============================================================================
# ⚠️  Never commit .env.local to version control
# ⚠️  Keep SUPABASE_SERVICE_ROLE_KEY secret (server-side only)
# ⚠️  Use different keys for dev/staging/production
# ⚠️  Rotate API keys regularly

# ==============================================================================
# DEV DEBUG TOOLS (optional, local only)
# ==============================================================================
# The /debug pages need no auth themselves, but several drive real product
# routes (/api/admin/lesson-studio/*, /api/user/wsi-questions/*) that 401
# without a session. Setting these lets middleware supply a stand-in identity
# for ANONYMOUS requests only — a real logged-in session always takes priority,
# so role-gated behaviour stays testable locally.
#
# Ignored entirely when NODE_ENV=production. Use the id of your own admin user
# (auth.users.id); it is intentionally not committed because this repo is public.
DEBUG_USER_ID=
DEBUG_USER_ROLE=admin
