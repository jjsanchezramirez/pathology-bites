# Dependencies
node_modules/
.npm/

# Build outputs & cache
.next/
.swc/
out/
build/
dist/
*.tsbuildinfo

# Environment variables
.env
.env.*
*.env
!.env.example

# Local Supabase access token hand-off for one-off CLI dumps (never committed)
.supabase-token
supabase/.temp/
supabase/.branches/

# Logs & runtime
*.log
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*

# IDEs & editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.claude/
.kilocode/

# Mockups & samples
mockup-*.html
SAMPLE_*.ts

# Deployment
.vercel

# Temporary
*.tmp
*.temp
.cache/

# Project-specific
# Ignore all of dev/, EXCEPT the overhaul changelog (the overhaul's running log
# and final-report source) which we want version-controlled. Negations must
# un-ignore each parent dir before the file.
dev/*
!dev/docs/
dev/docs/*
!dev/docs/OVERHAUL-CHANGELOG.md

# Local-only sandbox (never committed, never deployed)
src/app/debug/
src/app/api/debug/

# FFmpeg WASM files (download via npm postinstall)
public/ffmpeg/

# AI-assistant tooling state (defensive — these tools may write local config)
.cursor/
.windsurf/
.clinerules/
.opencode/

# IHC datasets are generated artifacts published to R2 (data/ihc/*.json.br), not
# committed — each rebuild rewrites the whole multi-MB file and git can't delta it.
# Rebuild: dev/resources/who_classification/build_ihc_matrix.mjs --assemble
# Publish: dev/resources/who_classification/r2_publish_ihc.mjs
public/data/

# Migrations are dev artifacts applied via Supabase, not app source. They live in
# dev/supabase/migrations/ (gitignored) alongside dev/code/scripts/migrations/.
# Keeping this ignored stops one being committed to the repo root by accident.
supabase/migrations/

# Wrangler local state (R2/D1 simulator cache)
.wrangler/
